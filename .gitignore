# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ipynb_checkpoints/

# Node
node_modules/
dist/
build/

# Data (large/raw, keep out unless explicitly tracked)
data/raw/
*.csv
*.parquet
!data/**/README.md

# Env / secrets
.env
.env.*
*.key
*.pem

# OS / editor
.DS_Store
.idea/
.vscode/
data/twin.db

# Unity (generated/cache -- the actual project isn't checked in, see unity/README.md)
unity/*/Library/
unity/*/Temp/
unity/*/Obj/
unity/*/Build/
unity/*/Builds/
unity/*/Logs/
unity/*/UserSettings/
unity/*/.vs/
unity/*/*.csproj
unity/*/*.sln
unity/*/*.user
